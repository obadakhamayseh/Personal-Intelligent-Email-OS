# ============================================================================
# Personal Intelligent Email OS - Environment Configuration
# ============================================================================

# --- Application & Security ---
APP_NAME="Personal Intelligent Email OS"
APP_ENV="production"
DEBUG=false
API_V1_PREFIX="/api/v1"
# 32-byte URL-safe base64-encoded key for Fernet symmetric encryption of OAuth tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY="cGVyc29uYWwtaW50ZWxsaWdlbnQtZW1haWwtb3MtZmVybmV0LWtleS0zMmI="
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://127.0.0.1:3005"

# --- PostgreSQL 16 + pgvector ---
POSTGRES_USER="emailos"
POSTGRES_PASSWORD="emailos_secure_password"
POSTGRES_DB="emailos_db"
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://emailos:emailos_secure_password@postgres:5432/emailos_db"
SYNC_DATABASE_URL="postgresql://emailos:emailos_secure_password@postgres:5432/emailos_db"

# --- Redis (Rate limiting, locks & caching) ---
REDIS_URL="redis://redis:6379/0"

# --- Google OAuth 2.0 (Gmail API) ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.labels"

# --- AI / LLM Layer (Gemini Primary + OpenAI Fallback) ---
PRIMARY_LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
EMBEDDING_DIMENSION=768

OPENAI_API_KEY="your-openai-fallback-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Telegram Command Center ---
TELEGRAM_BOT_TOKEN="1234567890:AAH_your_telegram_bot_token_here"
# Comma-separated list of numeric Telegram User IDs allowed to control the OS
ALLOWED_TELEGRAM_USER_IDS="123456789,987654321"

# --- Scheduler & Cleanup Defaults ---
SYNC_INTERVAL_MINUTES=5
CLEANUP_CRON_HOUR=3
DIGEST_DAY_OF_WEEK="sun"
DIGEST_HOUR=9
GHOSTED_SLA_HOURS=72
